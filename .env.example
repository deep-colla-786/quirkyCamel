# Razorpay keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Use rzp_test_* keys while testing, rzp_live_* in production.
# While these placeholders are in place the site runs a demo checkout instead.
RAZORPAY_KEY_ID=rzp_test_DUMMYKEY000000
RAZORPAY_KEY_SECRET=dummy_secret_replace_me

# MongoDB connection string (database name in the path)
MONGODB_URI=mongodb://127.0.0.1:27017/quirkycamel

# The store's public address, used in links inside emails (password reset, tracking) and
# for search engines. Required in production, e.g. https://quirkycamel.in
PUBLIC_URL=

# Number of reverse proxies in front of the server (e.g. 1 behind Nginx or a hosting
# platform's load balancer). 0 = visitors connect directly; X-Forwarded-For is then ignored.
TRUST_PROXY=0

# Admin account (created/updated automatically on server start; stored hashed in MongoDB)
ADMIN_EMAIL=admin@example.com
# At least 12 characters and not a common password: the server refuses to start otherwise.
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Store Admin

# Email (invoices + admin order alerts) via Gmail:
#   1. Turn on 2-Step Verification for the Gmail account that will send the emails.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Put that Gmail address in SMTP_USER and the 16-character App Password in SMTP_PASS.
#   4. Restart the server (npm run dev), then run: npm run mail:test
# Port 587 is used because antivirus email scanning (e.g. AVG Mail Shield) breaks port 465.
# While SMTP_USER/SMTP_PASS are empty, emails are saved as .html files in outbox/ instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Shiprocket delivery (Settings -> API in Shiprocket). Login uses an API user's email + password.
# Leave SHIPROCKET_EMAIL empty to use the built-in demo courier instead.
SHIPROCKET_EMAIL=
# Single quotes keep characters like $ and # exactly as typed.
SHIPROCKET_PASSWORD='your-api-user-password'
# Name of the pickup address in Shiprocket (Settings -> Pickup Addresses), e.g. Primary
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_CITY=Mumbai
SHIPROCKET_PICKUP_STATE=Maharashtra
# PIN code of the pickup address (for the delivery-time check on product pages).
SHIPROCKET_PICKUP_PIN=
# Paste this into Shiprocket -> Settings -> API -> Webhooks as the security token (x-api-key).
# At least 32 random characters; the webhook stays switched off without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SHIPROCKET_WEBHOOK_TOKEN=
# Parcel size (cm) and weight per item (kg) sent to Shiprocket.
SHIPROCKET_BOX_LENGTH_CM=22
SHIPROCKET_BOX_BREADTH_CM=16
SHIPROCKET_BOX_HEIGHT_CM=8
SHIPROCKET_WEIGHT_PER_ITEM_KG=0.3
# Demo courier only: minutes between simulated tracking updates.
SHIPROCKET_DEMO_STEP_MINUTES=2
